// File name: projects/01/Mux8Way16.hdl

/**
 * 8-way 16-bit multiplexor:
 * out = a if sel == 000
 *       b if sel == 001
 *       etc.
 *       h if sel == 111
 */

CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    // Put your code here:
   Mux16(a=a,b=b,sel=sel[0],out=ao); 
   Mux16(a=c,b=d,sel=sel[0],out=bo);
	Mux16(a=e,b=f,sel=sel[0],out=ao1); 
   Mux16(a=g,b=h,sel=sel[0],out=bo1);
	Mux16(a=ao,b=bo,sel=sel[1],out=ao2);
	Mux16(a=ao1,b=bo1,sel=sel[1],out=bo2);
	Mux16(a=ao2,b=bo2,sel=sel[2],out=out);
}